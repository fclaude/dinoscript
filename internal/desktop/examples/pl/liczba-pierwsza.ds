# Uruchom program i wpisz liczbę całkowitą, na przykład 25 lub 29.
function czyPierwsza(n)
  if n < 2 then
    output false
  end if
  if n = 2 then
    output true
  end if
  if n % 2 = 0 then
    output false
  end if
  let dzielnik = 3
  while dzielnik <= n // dzielnik do
    if n % dzielnik = 0 then
      output false
    end if
    let dzielnik = dzielnik + 2
  end while
  output true
end function

print("Którą liczbę całkowitą chcesz sprawdzić?")
let liczba = readint()
if czyPierwsza(liczba) then
  print(liczba, " to liczba pierwsza.")
else
  print(liczba, " nie jest liczbą pierwszą.")
end if
